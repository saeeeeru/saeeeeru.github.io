---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';
---

<Base title={`その席、もうありません｜${profile.name}`} description="その席、もうありません">
  <SiteHeader />
  <main id="content" class="room lost">
    <div class="noren faded" aria-hidden="true">
      <span class="noren-strips">
        <span>閉</span><span>店</span>
      </span>
    </div>
    <p class="sold-out">その品は品切れです</p>
    <article class="menu-sheet">
      <h1>その席、もうありません</h1>
      <p>のれんの向こうに、その席はありません。</p>
      <p><a href={withBase('/')}>居酒屋 冴に戻る</a></p>
    </article>
  </main>
  <SiteFooter />
</Base>
