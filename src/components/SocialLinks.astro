---
import { profile } from '../data/profile';

const labels: Record<string, string> = {
  GitHub: 'GitHub',
  X: 'X',
  note: 'note',
  sizu: 'sizu',
  Facebook: 'Facebook',
  Instagram: 'Instagram',
  LinkedIn: 'LinkedIn',
  Email: 'メール',
};
---

<ul class="icon-row">
  {
    profile.social.map((item) => (
      <li>
        <a
          class="icon-link"
          href={item.href}
          aria-label={labels[item.name] ?? item.name}
          {...(item.href.startsWith('http')
            ? { target: '_blank', rel: 'me noopener noreferrer' }
            : { rel: 'me' })}
        >
          {item.name === 'GitHub' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.36-3.87-1.36-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" /></svg>
          )}
          {item.name === 'X' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z" /></svg>
          )}
          {item.name === 'note' && <span aria-hidden="true">note</span>}
          {item.name === 'sizu' && <span aria-hidden="true">sizu</span>}
          {item.name === 'Facebook' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 8.5V6.8c0-.8.2-1.2 1.3-1.2H17V3h-2.1C12.2 3 11 4.4 11 6.6v1.9H9v2.7h2V21h3.5v-9.8h2.3l.4-2.7h-2.7z" /></svg>
          )}
          {item.name === 'Instagram' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="4" width="16" height="16" rx="4" /><circle cx="12" cy="12" r="3.5" /><circle cx="17.2" cy="6.8" r="0.8" fill="currentColor" stroke="none" /></svg>
          )}
          {item.name === 'LinkedIn' && (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.7 8.7H2.9V21h2.8V8.7zM4.3 3C3.3 3 2.5 3.8 2.5 4.8S3.3 6.6 4.3 6.6 6.1 5.8 6.1 4.8 5.3 3 4.3 3zM21.1 21h-2.8v-6.4c0-1.8-.8-2.4-1.8-2.4s-2 .9-2 2.5V21H11.7V8.7h2.7v1.7c.5-.9 1.7-1.9 3.5-1.9 2.3 0 4.2 1.5 4.2 4.8V21z" /></svg>
          )}
          {item.name === 'Email' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M4 7l8 6 8-6" /></svg>
          )}
          {item.href.startsWith('http') && <span class="sr-only">（新しいタブで開きます）</span>}
        </a>
      </li>
    ))
  }
</ul>
