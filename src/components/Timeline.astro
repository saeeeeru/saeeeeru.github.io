---
import type { TimelineEntry } from '../data/profile';
import { normalizePoint } from '../data/profile';
import { renderInline } from '../lib/inline';

interface Props {
  entries: TimelineEntry[];
  kind: 'job' | 'school';
}

const { entries, kind } = Astro.props;

function plain(text: string): string {
  return text.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/\*\*/g, '');
}

function months(period: string): number {
  const match = period.match(/(\d{4})\/(\d{2})\s*~\s*(現在|\d{4}\/\d{2})/);
  if (!match) return 12;
  const start = Number(match[1]) * 12 + Number(match[2]);
  let end = start + 12;
  if (match[3] === '現在') {
    const now = new Date();
    end = now.getFullYear() * 12 + now.getMonth() + 1;
  } else {
    const [year, month] = match[3].split('/');
    end = Number(year) * 12 + Number(month);
  }
  return Math.max(1, end - start);
}

const lengths = entries.map((entry) => months(entry.period));
const longest = Math.max(...lengths, 1);
---

<ul class="shelf">
  {
    entries.map((entry, index) => {
      const current = entry.period.includes('現在');
      const tag = kind === 'school' ? '卒業' : current ? 'キープ中' : '空き瓶';
      const summary = plain(normalizePoint(entry.points[0]).text);
      const fill = current ? Math.round((lengths[index] / longest) * 100) : 6;
      return (
        <li class="shelf-item">
          <details class="bottle-card">
            <summary class="bottle-summary">
              <span class={`bottle bottle-${index % 4}${current ? '' : ' is-empty'}`} style={`--fill: ${fill}%`} aria-hidden="true"></span>
              <span class="name-tag">
                <span class={`keep-tag ${current ? 'is-current' : ''}`}>{tag}</span>
                <span class="name-tag-org">{entry.org}{entry.suffix ?? ''}</span>
                <span class="name-tag-period">{entry.period}</span>
                <span class="name-tag-role">{summary}</span>
              </span>
            </summary>
            <div class="bottle-note">
              {entry.url && (
                <p>
                  <a href={entry.url} target="_blank" rel="noopener noreferrer">
                    {entry.org}
                    <span class="sr-only">（新しいタブで開きます）</span>
                  </a>
                  {entry.suffix ?? ''}
                </p>
              )}
              <ul>
                {entry.points.map((point) => {
                  const item = normalizePoint(point);
                  return (
                    <li>
                      <span set:html={renderInline(item.text)} />
                      {item.children.length > 0 && (
                        <ul>
                          {item.children.map((child) => (
                            <li set:html={renderInline(child)} />
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          </details>
        </li>
      );
    })
  }
</ul>
