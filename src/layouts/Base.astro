---
import '../styles/global.css';
import { profile } from '../data/profile';
import { absoluteUrl, isPreview, withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description = profile.description, path = Astro.url.pathname } = Astro.props;
const canonical = absoluteUrl(path, Astro.site);
const image = absoluteUrl(profile.image, Astro.site);
const ogImage = absoluteUrl('/og.png', Astro.site);
const sameAs = profile.social.filter((item) => item.href.startsWith('http')).map((item) => item.href);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Yamamuro Saeru',
  alternateName: ['さえない', profile.name],
  url: profile.site,
  image,
  jobTitle: profile.jobTitle,
  email: 'saeeeeru29@gmail.com',
  worksFor: {
    '@type': 'Organization',
    name: profile.now.org,
    url: profile.now.orgUrl,
  },
  sameAs,
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#2a1c12" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@saeeeeru" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={profile.name} href={withBase('/feed.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <div id="closed-sign" class="closed-sign" hidden>
      <div class="paper-sign" role="dialog" aria-modal="true" aria-labelledby="closed-title">
        <h2 id="closed-title">本日は閉店しました</h2>
        <p>大将は子どもを寝かしつけ中です</p>
        <button type="button" id="closed-enter">それでも入る</button>
      </div>
    </div>
    <div id="shop">
      <a class="skip-link" href="#content">店内へスキップ</a>
      <p id="karaoke-live" class="sr-only" aria-live="polite"></p>
      <slot />
      <dialog id="receipt" class="receipt" aria-labelledby="receipt-title">
        <form method="dialog">
          <p class="receipt-shop">居酒屋 冴</p>
          <p id="receipt-guest">上様</p>
          <p id="receipt-when"></p>
          <p id="receipt-no"></p>
          <h2 id="receipt-title">お会計</h2>
          <ul id="receipt-lines"></ul>
          <p id="receipt-total">合計　時価</p>
          <p class="receipt-thanks">またのお越しを</p>
          <button type="submit">伝票を閉じる</button>
        </form>
      </dialog>
    </div>
    <script>
      import '../scripts/izakaya.ts';
    </script>
  </body>
</html>
