---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Timeline from '../components/Timeline.astro';
import { profile } from '../data/profile';
import { renderInline } from '../lib/inline';
import { loadWriting } from '../lib/feeds';
import { loadRepos, repoByName, type Repo } from '../lib/repos';
import { formatTimestamp } from '../lib/format';
import { withBase } from '../lib/url';

const writing = await loadWriting();
const repos = await loadRepos();
const byName = repoByName(repos);
const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const projectsById = new Map(projects.map((entry) => [entry.id, entry]));
const excluded = new Set([...profile.github.exclude, ...profile.pinned]);
const otherRepos = repos
  .filter((repo) => !excluded.has(repo.name))
  .sort((a, b) => (a.updated < b.updated ? 1 : -1));

const themeIds = new Set(profile.themes.flatMap((theme) => theme.writeups));
const otherWriteups = projects.filter((entry) => !themeIds.has(entry.id));

const visibleWritingCount = 3;

function shortSkill(skill: string): string {
  const head = skill.split('(')[0]?.trim() ?? skill;
  return head.split('/')[0]?.trim() || skill;
}

function wareki(date: Date): string {
  const year = date.getUTCFullYear();
  const month = date.getUTCMonth() + 1;
  if (year > 2019 || (year === 2019 && month >= 5)) {
    const n = year - 2018;
    return n === 1 ? '令和元年仕込み' : `令和${n}年仕込み`;
  }
  return `平成${year - 1988}年仕込み`;
}
const articles = [
  ...writing.note.map((item) => ({ ...item, source: profile.writing.note.title, sourceUrl: profile.writing.note.url })),
  ...writing.sizu.map((item) => ({ ...item, source: profile.writing.sizu.title, sourceUrl: profile.writing.sizu.url })),
].sort((a, b) => {
  if (a.date === b.date) return 0;
  if (!a.date) return 1;
  if (!b.date) return -1;
  return a.date < b.date ? 1 : -1;
});
const visibleArticles = articles.slice(0, visibleWritingCount);
const moreArticles = articles.slice(visibleWritingCount);

function repoHref(name: string, repo: Repo | undefined): string {
  return repo?.url ?? `https://github.com/${profile.github.user}/${name}`;
}

---

<Base title={`${profile.name}｜居酒屋 冴`} description={profile.description} path="/">
  <SiteHeader />
  <main id="content">
    <section id="entrance" class="entrance" data-receipt="のれん" aria-labelledby="sign">
      <div class="eaves" aria-hidden="true"></div>
      <div class="lantern-pair">
        <button type="button" class="akachochin" id="lantern-tap" aria-label="赤提灯">
          <span class="lantern-cord"></span>
          <span class="lantern-cap"></span>
          <span class="lantern-body"><span>冴</span></span>
          <span class="lantern-cap bottom"></span>
        </button>
        <h1 id="sign" class="shop-sign">居酒屋 冴</h1>
        <div class="akachochin plain" aria-hidden="true">
          <span class="lantern-cord"></span>
          <span class="lantern-cap"></span>
          <span class="lantern-body"></span>
          <span class="lantern-cap bottom"></span>
        </div>
      </div>
      <p class="shop-en">{profile.name}</p>
      <p class="shop-line">{profile.oneLiner}</p>
      <p class="prep-board">仕込み中</p>
      <a id="noren" class="noren rope" href="#counter">
        <span class="sr-only">縄のれんをくぐる</span>
        <span class="rope-row" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </span>
        <span class="noren-mark">さえない</span>
      </a>
      <label class="glass">
        <input class="glass-toggle" type="checkbox" />
        <span class="sr-only">とりあえず生を注ぐ</span>
        <span class="glass-ui" aria-hidden="true">
          <span class="glass-bowl">
            <span class="foam"></span>
            <span class="beer"></span>
          </span>
          <span class="glass-stem"></span>
          <span class="glass-foot"></span>
          <span class="kanpai" aria-hidden="true">乾杯！</span>
          <span class="glass-caption"><span class="tap-long">タップで注ぐ</span><span class="tap-short">注ぐ</span></span>
        </span>
      </label>
    </section>

    <div id="counter" class="interior">
      <div class="floor-top">
      <section id="now" class="panel taisho-sign" data-receipt="今日の大将">
        <h2>今日の大将</h2>
        <p class="taisho-role">{profile.now.org}　{profile.jobTitle}</p>
        <p class="asof">{profile.now.asOf}</p>
        <ul>
          {
            profile.now.items.map((item) => (
              <li>
                <span>{item.label}</span>
                {item.detail && <small>{item.detail}</small>}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="writing" class="panel chalkboard" data-receipt="本日のおすすめ">
        <div class="board-head">
          <h2>本日のおすすめ</h2>
          <p>
            <a href={profile.writing.note.url} target="_blank" rel="noopener noreferrer">
              note<span class="sr-only">（新しいタブで開きます）</span>
            </a>
            <span aria-hidden="true"> / </span>
            <a href={profile.writing.sizu.url} target="_blank" rel="noopener noreferrer">
              sizu<span class="sr-only">（新しいタブで開きます）</span>
            </a>
          </p>
        </div>
        <p class="enkai-hint"><span class="hint-key">宴会のご予約は ↑↑↓↓←→←→BA</span><span class="hint-tap">提灯を5回たたくと宴会</span></p>
        <ol class="song-list">
          {
            visibleArticles.map((article, index) => (
              <li>
                <span class="song-no">{String(index + 1).padStart(2, '0')}</span>
                <a href={article.url} target="_blank" rel="noopener noreferrer">
                  {article.title}
                  <span class="sr-only">（新しいタブで開きます）</span>
                </a>
                <span class="song-meta">
                  {article.date && <time datetime={article.date}>{formatTimestamp(article.date)}</time>}
                  <span aria-hidden="true">・</span>
                  <a href={article.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {article.source}
                    <span class="sr-only">（新しいタブで開きます）</span>
                  </a>
                </span>
              </li>
            ))
          }
        </ol>
        {
          moreArticles.length > 0 && (
            <details class="more">
              <summary>もっと見る（{moreArticles.length}）</summary>
              <ol class="song-list" start={visibleArticles.length + 1}>
                {moreArticles.map((article, index) => (
                  <li>
                    <span class="song-no">{String(visibleArticles.length + index + 1).padStart(2, '0')}</span>
                    <a href={article.url} target="_blank" rel="noopener noreferrer">
                      {article.title}
                      <span class="sr-only">（新しいタブで開きます）</span>
                    </a>
                    <span class="song-meta">
                      {article.date && <time datetime={article.date}>{formatTimestamp(article.date)}</time>}
                      <span aria-hidden="true">・</span>
                      <a href={article.sourceUrl} target="_blank" rel="noopener noreferrer">
                        {article.source}
                        <span class="sr-only">（新しいタブで開きます）</span>
                      </a>
                    </span>
                  </li>
                ))}
              </ol>
            </details>
          )
        }
      </section>
      </div>

      <section id="projects" class="panel menu-wall" data-receipt="お品書き">
        <h2 class="section-title noren-band">お品書き</h2>
        <div class="wall">
          {
            profile.themes.map((theme) => (
              <article class="wall-feature" aria-labelledby={`theme-${theme.id}`}>
                <h3 id={`theme-${theme.id}`} class="feature-plaque">
                  <span>{theme.title}</span>
                  <span class="meibutsu">名物</span>
                </h3>
                <div class="wall-note">
                  <p>{theme.summary}</p>
                  <ul class="chip-list">
                    {theme.repos.map((name) => {
                      const repo = byName.get(name);
                      return (
                        <li>
                          <a href={repoHref(name, repo)} target="_blank" rel="noopener noreferrer">
                            {name}
                            <span class="sr-only">（新しいタブで開きます）</span>
                          </a>
                          {repo && repo.stars > 0 && <span>★{repo.stars}</span>}
                        </li>
                      );
                    })}
                  </ul>
                  <ul class="writeups">
                    {theme.writeups.map((id) => {
                      const entry = projectsById.get(id);
                      if (!entry) return null;
                      return (
                        <li>
                          <a href={withBase(`/${entry.id}/`)}>{entry.data.title}</a>
                          <time datetime={entry.data.date.toISOString().slice(0, 10)}>{wareki(entry.data.date)}</time>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </article>
            ))
          }
          <ul class="dish-list">
            {
              otherWriteups.map((entry) => (
                <li>
                  <a href={withBase(`/${entry.id}/`)}>{entry.data.title}</a>
                  <span>{wareki(entry.data.date)}</span>
                </li>
              ))
            }
          </ul>
          <div class="skill-line">
          <p class="wall-price">全品 時価</p>
          <ul id="skills" class="tanzaku-row">
            {
              profile.skills.map((skill) => (
                <li class="tanzaku skill-strip">
                  <span class={shortSkill(skill) === 'SQL' ? 'upright' : ''}>{shortSkill(skill)}</span>
                  <span class="skill-full">{skill}</span>
                </li>
              ))
            }
          </ul>
          </div>
        </div>
        <p class="scroll-hint">← 横に見る</p>
        {
          otherRepos.length > 0 && (
            <details class="more">
              <summary>もっと見る（お通し {otherRepos.length}）</summary>
              <ul class="side-menu">
                {otherRepos.map((repo) => (
                  <li>
                    <a href={repo.url} target="_blank" rel="noopener noreferrer">
                      {repo.name}
                      <span class="sr-only">（新しいタブで開きます）</span>
                    </a>
                    <span>{repo.description ?? ''}</span>
                    {repo.stars > 0 && <span>★{repo.stars}</span>}
                  </li>
                ))}
              </ul>
            </details>
          )
        }
      </section>

      <section id="career" class="panel" data-receipt="ボトルキープ">
        <h2 class="section-title noren-band">ボトルキープ棚</h2>
        <Timeline entries={profile.career} kind="job" />
        <Timeline entries={profile.education} kind="school" />
        <p class="scroll-hint">← 横に見る</p>
      </section>

      <section class="panel register" aria-labelledby="register-title">
        <h2 id="register-title" class="section-title noren-band">レジの横</h2>
        <div class="register-grid">
          <figure class="shikishi">
            <img src={withBase(profile.image)} alt={profile.imageAlt} width="96" height="96" />
            <figcaption>{profile.name}</figcaption>
          </figure>
          <div>
            <details class="more bio">
              <summary>大将の自己紹介</summary>
              <div class="bio-body">
                {profile.intro.map((paragraph) => <p set:html={renderInline(paragraph)} />)}
              </div>
            </details>
            <SocialLinks />
          </div>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>
