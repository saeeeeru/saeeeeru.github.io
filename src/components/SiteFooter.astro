---
import { profile } from '../data/profile';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="flex flex-wrap items-baseline gap-x-4 border-t border-[var(--line)] py-3 text-sm text-[var(--muted)]">
  <p>
    {profile.name} © {year}
  </p>
  <p>
    <a href={withBase('/feed.xml')}>RSS</a>
  </p>
</footer>
