---
import { profile } from '../data/profile';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="mx-auto mt-16 max-w-2xl border-t border-[var(--line)] px-5 py-8 text-sm text-[var(--muted)]">
  <p>
    {profile.name} © {year}
  </p>
  <p class="mt-2">
    <a href={withBase('/feed.xml')}>RSS</a>
  </p>
</footer>
