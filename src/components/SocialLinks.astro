---
import { profile } from '../data/profile';

const labels: Record<string, string> = {
  GitHub: 'GitHub',
  X: 'X',
  note: 'note',
  sizu: 'sizu',
  Facebook: 'Facebook',
  Instagram: 'Instagram',
  LinkedIn: 'LinkedIn',
  Email: 'メール',
};
---

<ul class="matchboxes">
  {
    profile.social.map((item) => (
      <li>
        <a
          class="matchbox"
          href={item.href}
          {...(item.href.startsWith('http')
            ? { target: '_blank', rel: 'me noopener noreferrer' }
            : { rel: 'me' })}
        >
          <span class="matchbox-shop" aria-hidden="true">居酒屋 冴</span>
          <span class="matchbox-name">{labels[item.name] ?? item.name}</span>
          {item.href.startsWith('http') && <span class="sr-only">（新しいタブで開きます）</span>}
        </a>
      </li>
    ))
  }
</ul>
