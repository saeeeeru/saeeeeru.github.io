---
import type { TimelineEntry } from '../data/profile';
import { normalizePoint } from '../data/profile';
import { renderInline } from '../lib/inline';

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

<ul class="space-y-0.5">
  {
    entries.map((entry) => (
      <li>
        <details class="role">
          <summary>
            <span class="meta shrink-0">{entry.period}</span>
            <span class="min-w-0 truncate font-medium">
              {entry.org}
              {entry.suffix ?? ''}
            </span>
          </summary>
          <div class="role-body">
            {entry.url && (
              <p>
                <a href={entry.url} target="_blank" rel="noopener noreferrer">
                  {entry.org}
                  <span class="sr-only">（新しいタブで開きます）</span>
                </a>
                {entry.suffix ?? ''}
              </p>
            )}
            <ul>
              {entry.points.map((point) => {
                const item = normalizePoint(point);
                return (
                  <li>
                    <span set:html={renderInline(item.text)} />
                    {item.children.length > 0 && (
                      <ul>
                        {item.children.map((child) => (
                          <li set:html={renderInline(child)} />
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
            </ul>
          </div>
        </details>
      </li>
    ))
  }
</ul>
